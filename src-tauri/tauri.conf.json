{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HMACFR",
  "version": "1.0.0",
  "identifier": "com.hmacfr.forensics",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:8000/ui"
  },
  "app": {
    "windows": [
      {
        "title": "HMACFR — Digital Forensics & Evidence Preservation Framework",
        "width": 1380,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
