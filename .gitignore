*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example

# --- Databases & Vector Stores ---
*.db
*.sqlite
*.sqlite3
backend/knowledge_base/chroma_db/
backend/app/db/*.db
backend/app/db/*.sqlite

# --- Forensic Evidence Vault & Raw Dump Images (Keep Local) ---
backend/evidence_vault/
evidence_vault/
evidences/
backend/uploads/*
!backend/uploads/.gitkeep
*.E01
*.e01
*.001
*.raw
*.mem
*.vmem
*.dmp
*.dd
*.img
*.pcap
*.pcapng
*.evtx
*.mbox

# Allow small test fixtures in sample_evidence
!backend/sample_evidence/*
!backend/sample_evidence/**

# --- Generated Forensic Case Analysis Outputs ---
backend/output/
output/
test_disk_out*

